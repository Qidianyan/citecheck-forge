{
  "name": "citecheck-rovo",
  "version": "0.1.0",
  "private": true,
  "description": "CiteCheck: a Rovo Agent for Confluence and Jira that verifies legal citations in AI-generated text against official statute texts (Vietnam, Indonesia, Thailand).",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build:corpus": "node scripts/build-corpus.mjs",
    "test": "node --test \"test/*.test.js\"",
    "eval": "node eval/run-eval.mjs",
    "lint:forge": "forge lint"
  },
  "dependencies": {
    "@forge/api": "^8.5.0",
    "@forge/kvs": "^2.1.2",
    "@forge/react": "^12.5.0",
    "@forge/resolver": "^2.0.2",
    "@forge/bridge": "^7.3.0",
    "react": "^18.3.1"
  },
  "engines": { "node": ">=22" }
}
